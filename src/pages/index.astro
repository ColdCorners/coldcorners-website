---
import '../styles/home.css';
import BaseHead from '../components/BaseHead.astro';
import Brand from '../components/Brand.astro';
import PageLinks from '../components/PageLinks.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import { appIconUrl, authorUrl, footerLinks, helpLinks, siteName } from '../site.mjs';
import { screenshots } from '../screenshots';

const navigation = [{ href: '#screenshots', label: 'Screenshots' }, ...helpLinks];
const heroSmall = '/screenshots/hero-map-800.webp?v=2';
const heroLarge = '/screenshots/hero-map-1440.webp?v=2';
const description = 'Keep macOS Hot Corners active on your MacBook and quiet on the presentation display. Pause them all on a timer or toggle corner locking with a keyboard shortcut.';
const app = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: siteName,
  operatingSystem: 'macOS',
  applicationCategory: 'UtilitiesApplication',
  url: new URL('/', Astro.site).href,
  image: new URL(appIconUrl, Astro.site).href,
  description,
  screenshot: screenshots.map(({ id }) => new URL(`/screenshots/${id}.webp`, Astro.site).href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="ColdCorners for Mac - Cool down Hot Corners by display"
      description={description}
      shareImage={{
        path: '/screenshots/coldcorners-social.jpg?v=snowflake',
        alt: 'ColdCorners shows the top left Hot Corner enabled on a MacBook Pro beside a Studio Display with no corners enabled.',
        width: 1200, height: 630, type: 'image/jpeg',
      }}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(app).replace(/</g, '\\u003c')} />
  </head>
  <body class="home">
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-frame">
      <header class="home-header">
        <Brand />
        <PageLinks label="Main navigation" links={navigation} />
      </header>
      <main id="content">
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">Cool down your Mac's <span>Hot Corners.</span></h1>
            <p>Keep Mission Control handy on your laptop without triggering it on your external display. Choose which corners stay active on each screen, or pause them all on a timer.</p>
            <div class="hero-actions">
              <a class="primary-link" href="#screenshots">Explore screenshots</a>
              <a class="text-link" href="/faq/#setup">Read the setup guide</a>
            </div>
            <p class="availability">Coming soon to the Mac App Store.</p>
          </div>
          <a class="hero-image" href={heroLarge} aria-label="Open the full-size ColdCorners display map screenshot">
            <img src={heroSmall} srcset={`${heroSmall} 800w, ${heroLarge} 1440w`} sizes="(max-width: 49rem) 94vw, (max-width: 80rem) 55vw, 44rem" width="1440" height="1114" fetchpriority="high" alt="ColdCorners Settings with the top left Hot Corner allowed on the MacBook Pro and no corners allowed on the Studio Display." />
          </a>
        </section>
        <ScreenshotGallery />

        <section class="getting-started product-section" aria-labelledby="setup-title">
          <div>
            <h2 id="setup-title">Set up your first corner</h2>
            <p>Your Mac still decides what a Hot Corner does. ColdCorners decides where it can activate.</p>
            <a class="text-link" href="/faq/">Browse the FAQ</a>
          </div>
          <ol class="steps">
            <li><strong>Grant permission.</strong> Open the Permissions tab and allow ColdCorners to filter pointer movement at blocked corners.</li>
            <li><strong>Choose an action in macOS.</strong> Use "Open Hot Corners Settings..." to assign an action such as Mission Control.</li>
            <li><strong>Pick a corner on the map.</strong> Enable ColdCorners, choose "Block selected corners", and check the corner on the display where the action gets in your way.</li>
          </ol>
        </section>
        <section class="menu-status" id="menu-status" aria-labelledby="menu-status-title">
          <h2 id="menu-status-title">Reading the menu bar icon</h2>
          <div>
            <p class="status-line"><img src="/icons/coldcorners-enabled.svg" width="24" height="24" alt="Four corner marks around a snowflake" />ColdCorners is ready to apply your rules.</p>
            <p class="status-line"><img src="/icons/coldcorners-disabled.svg" width="24" height="24" alt="Four empty corner marks" />Filtering is off or needs attention. Check Settings.</p>
          </div>
        </section>
      </main>
      <footer class="home-footer">
        <p>ColdCorners by <a href={authorUrl}>Ighor July</a></p>
        <PageLinks label="Footer navigation" links={[...helpLinks, ...footerLinks]} />
      </footer>
    </div>
  </body>
</html>
