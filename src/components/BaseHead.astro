---
import '../styles/global.css';
import { siteName } from '../site.mjs';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  shareImage?: string;
  shareAlt?: string;
}

const { title, description, noindex = false, shareImage = '/coldcorners.png', shareAlt = 'ColdCorners app icon' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#0c121b" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="apple-touch-icon" href="/coldcorners.png" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(shareImage, Astro.site)} />
<meta property="og:image:alt" content={shareAlt} />
<meta name="twitter:card" content={Astro.props.shareImage ? 'summary_large_image' : 'summary'} />

<script is:inline defer data-domain="coldcorners.app" src="https://analytics.reverseeverything.com/js/script.outbound-links.tagged-events.js"></script>
<script is:inline>
  window.plausible = window.plausible || function() {
    (window.plausible.q = window.plausible.q || []).push(arguments);
  };
</script>
